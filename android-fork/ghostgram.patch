@@ -0,0 +1,60 @@
+package org.telegram.messenger;
+
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.Toast;
+import java.math.BigDecimal;
+import org.telegram.messenger.utils.tlutils.AmountUtils;
+
+/** Account-local presentation wallet. Never supplies a Telegram payment request. */
+public final class GhostGramWallet {
+    private static SharedPreferences prefs(int account) {
+        return ApplicationLoader.applicationContext.getSharedPreferences("ghostgram_wallet_" + UserConfig.getInstance(account).getClientUserId(), Context.MODE_PRIVATE);
+    }
+    public static long stars(int account) { return prefs(account).getLong("stars", 100_000); }
+    public static long ton(int account) { return prefs(account).getLong("ton", 100_000_000_000L); }
+    public static AmountUtils.Amount amount(int account, AmountUtils.Currency currency) {
+        long nanos = currency == AmountUtils.Currency.TON ? ton(account) : Math.min(stars(account), Long.MAX_VALUE / 1_000_000_000L) * 1_000_000_000L;
+        return AmountUtils.Amount.fromNano(nanos, currency);
+    }
+    public static void changed(int account) {
+        AndroidUtilities.runOnUIThread(() -> NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.starBalanceUpdated));
+    }
+    public static synchronized void rememberCost(int account, String id, long cost, boolean ton) {
+        prefs(account).edit().putLong("cost." + id, Math.max(0, cost)).putBoolean("ton." + id, ton).commit();
+    }
+    public static synchronized void spendOnce(int account, String id) {
+        SharedPreferences p = prefs(account);
+        if (!p.contains("cost." + id)) return;
+        boolean isTon = p.getBoolean("ton." + id, false);
+        GhostGramWalletMath next = new GhostGramWalletMath(stars(account), ton(account)).spend(isTon, p.getLong("cost." + id, 0));
+        if (p.edit().putLong(isTon ? "ton" : "stars", isTon ? next.ton : next.stars)
+                .remove("cost." + id).remove("ton." + id).commit()) changed(account);
+    }
+    public static void showEditor(Context context, int account) {
+        LinearLayout layout = new LinearLayout(context);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        int inset = AndroidUtilities.dp(24); layout.setPadding(inset, inset / 2, inset, 0);
+        EditText stars = new EditText(context); stars.setSingleLine(true); stars.setHint("Stars");
+        stars.setInputType(InputType.TYPE_CLASS_NUMBER); stars.setText(String.valueOf(stars(account))); layout.addView(stars);
+        EditText ton = new EditText(context); ton.setSingleLine(true); ton.setHint("TON");
+        ton.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL);
+        ton.setText(BigDecimal.valueOf(ton(account), 9).stripTrailingZeros().toPlainString()); layout.addView(ton);
+        AlertDialog dialog = new AlertDialog.Builder(context).setTitle("Баланс").setView(layout)
+                .setNegativeButton("Отмена", null).setPositiveButton("Сохранить", null).create();
+        dialog.setOnShowListener(ignored -> dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(view -> {
+            try {
+                long s = GhostGramWalletMath.parseStars(stars.getText().toString().trim());
+                long t = GhostGramWalletMath.parseTon(ton.getText().toString().trim());
+                if (s < 0 || s > 1_000_000_000_000L || t < 0 || t > 1_000_000_000_000_000_000L) throw new IllegalArgumentException();
+                if (!prefs(account).edit().putLong("stars", s).putLong("ton", t).commit()) throw new IllegalStateException();
+                changed(account); dialog.dismiss();
+            } catch (Exception error) { Toast.makeText(context, "Проверь Stars и TON (до 9 знаков после запятой)", Toast.LENGTH_LONG).show(); }
+        }));
+        dialog.show();
+    }
+}
