+                inTon ? (ton > cost ? ton - cost : 0) : ton);
+    }
+    public static long parseStars(String text) {
+        if (!text.matches("[0-9]+")) throw new IllegalArgumentException();
+        long value = Long.parseLong(text);
+        if (value > MAX_STARS) throw new IllegalArgumentException();
+        return value;
+    }
+    public static long parseTon(String text) {
+        if (!text.matches("[0-9]+([.,][0-9]{0,9})?")) throw new IllegalArgumentException();
+        long value = new BigDecimal(text.replace(',', '.')).movePointRight(9).longValueExact();
+        if (value > MAX_TON) throw new IllegalArgumentException();
+        return value;
+    }
+}
