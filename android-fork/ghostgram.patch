+package org.telegram.messenger;
+
+import java.math.BigDecimal;
+
+/** Exact local wallet arithmetic, independent of Android and payment APIs. */
+public final class GhostGramWalletMath {
+    public static final long MAX_STARS = 1_000_000_000_000L;
+    public static final long MAX_TON = 1_000_000_000_000_000_000L;
+    public final long stars, ton;
+    public GhostGramWalletMath(long stars, long ton) {
+        this.stars = Math.max(0, Math.min(MAX_STARS, stars));
+        this.ton = Math.max(0, Math.min(MAX_TON, ton));
+    }
+    public GhostGramWalletMath spend(boolean inTon, long cost) {
+        cost = Math.max(0, cost);
